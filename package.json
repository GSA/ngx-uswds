{
  "name": "usa-components",
  "version": "19.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run sandbox-icons && npm run docs:json && storybook dev -p 4200",
    "develop": "ng serve --port 4200",
    "build": "npm run build:components",
    "test": "npm run test:components",
    "build:components": "ng build uswds-components --configuration production",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:components": "ng test uswds-components --watch=false --code-coverage --no-progress --browsers=ChromeHeadless",
    "test:e2e": "playwright test",
    "ghpages": "npm run build-storybook && touch storybook-static/.nojekyll && npx angular-cli-ghpages --dir=storybook-static",
    "docs:json": "compodoc -p ./tsconfig.json -e json -d .",
    "sandbox-icons": "node src/sandbox/generate-icons.js",
    "storybook-old": "ng run docs:json && ng run usa-components:storybook",
    "storybook": "ng run usa-components:storybook",
    "build-storybook": "ng run usa-components:build-storybook"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "browser": {
    "fs": false,
    "os": false,
    "path": false
  },
  "dependencies": {
    "@angular/animations": "20.3.27",
    "@angular/common": "20.3.27",
    "@angular/compiler": "20.3.27",
    "@angular/core": "20.3.27",
    "@angular/forms": "20.3.27",
    "@angular/platform-browser": "20.3.27",
    "@angular/platform-browser-dynamic": "20.3.27",
    "@angular/router": "20.3.27",
    "@gsa-sam/sam-styles": "^3.0.25",
    "core-js": "^3.21.1",
    "ngx-highlightjs": "4.1.3",
    "ngx-markdown": "20.1.0",
    "rxjs": "7.8.2",
    "tslib": "^2.0.0",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.34",
    "@angular/cli": "20.3.34",
    "@angular/compiler-cli": "20.3.27",
    "@babel/core": "^7.29.7",
    "@compodoc/compodoc": "^1.2.1",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/addon-links": "10.5.7",
    "@storybook/angular": "10.5.7",
    "@storybook/react": "10.5.7",
    "@types/jasmine": "~3.6.0",
    "@types/node": "^16.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "angular-cli-github-pages": "0.2.0",
    "angular-eslint": "20.7.0",
    "ejs": "^3.1.6",
    "eslint": "9.39.5",
    "jasmine-core": "^3.6.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "ng-packagr": "20.3.2",
    "prettier": "3.9.6",
    "raw-loader": "^4.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "10.5.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  }
}
